# MySQL from docker-compose.yml (host port 3307 to avoid clashing with other local MySQL instances)
DATABASE_URL=mysql://app:app@127.0.0.1:3307/docplanner

# Only the chat search (stage 4) calls an LLM at runtime.
# Scraping, import, normalization and the AI enrichment pass all work without any key:
# enrichment was run once during development via Claude Code subagents and its validated
# result is committed to data/enriched/otodom-ai.json.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
