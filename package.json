{
  "name": "real-estate-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:import-raw": "node --env-file=.env scripts/import-raw.ts",
    "db:normalize": "node --env-file=.env scripts/normalize.ts",
    "db:report": "node --env-file=.env scripts/report.ts",
    "ai:prepare": "node --env-file=.env scripts/ai-prepare.ts",
    "ai:merge": "node --env-file=.env scripts/ai-merge.ts",
    "verify": "node --env-file=.env scripts/verify-offer.ts",
    "scrape": "node scripts/scrape-otodom.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.24.4",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
